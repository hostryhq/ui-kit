{
  "$description": "Hostry shared design tokens v0.1.1 (source of truth moved here from docs/design/tokens.json; light success and light border darkened to pass AA, see ui-kit README). Three tiers: primitive -> semantic -> component. Apps use semantic tokens only. Re-skin = change the 'brand' block (and re-run the contrast check). Contrast values are design estimates; CI must verify with the contrast script named in ui-kit-tokens.md section 10.",
  "version": "0.1.0",
  "brand": {
    "name": "Hostry",
    "primary":    { "light": "#0B5CAD", "dark": "#7DB7F2", "highContrast": "#003C8F" },
    "onPrimary":  { "light": "#FFFFFF", "dark": "#0A1A2B", "highContrast": "#FFFFFF" },
    "logo": "assets/brand/logo.svg"
  },
  "color": {
    "themes": {
      "light": {
        "bg":            "#FFFFFF",
        "surface":       "#F6F7F9",
        "surfaceRaised": "#FFFFFF",
        "border":        "#838C9A",
        "borderSubtle":  "#D5D9E0",
        "text":          "#14181F",
        "textMuted":     "#4A5260",
        "textOnAccent":  "#FFFFFF",
        "focusRing":     "#0B5CAD",
        "danger":        "#B3261E",
        "dangerBg":      "#FDECEA",
        "success":       "#1A7A38",
        "successBg":     "#E6F4EA",
        "warning":       "#8A5A00",
        "warningBg":     "#FFF4D6",
        "info":          "#0B5CAD",
        "infoBg":        "#E8F1FB"
      },
      "dark": {
        "bg":            "#0F1217",
        "surface":       "#1A1F27",
        "surfaceRaised": "#232A34",
        "border":        "#6B7584",
        "borderSubtle":  "#2F3743",
        "text":          "#F2F4F7",
        "textMuted":     "#A9B1BD",
        "textOnAccent":  "#0A1A2B",
        "focusRing":     "#7DB7F2",
        "danger":        "#FF8A80",
        "dangerBg":      "#3A1B19",
        "success":       "#5FD28A",
        "successBg":     "#14301F",
        "warning":       "#F2B84B",
        "warningBg":     "#3A2D0E",
        "info":          "#7DB7F2",
        "infoBg":        "#14263A"
      },
      "highContrast": {
        "_note": "Bright counters and sunlight. Light base, pure black text, 2 px borders, no tints that rely on subtle difference.",
        "bg":            "#FFFFFF",
        "surface":       "#FFFFFF",
        "surfaceRaised": "#FFFFFF",
        "border":        "#000000",
        "borderSubtle":  "#595959",
        "text":          "#000000",
        "textMuted":     "#262626",
        "textOnAccent":  "#FFFFFF",
        "focusRing":     "#000000",
        "danger":        "#8F0000",
        "dangerBg":      "#FFFFFF",
        "success":       "#005A1F",
        "successBg":     "#FFFFFF",
        "warning":       "#5C3B00",
        "warningBg":     "#FFFFFF",
        "info":          "#003C8F",
        "infoBg":        "#FFFFFF"
      },
      "kds": {
        "_note": "Kitchen display. Dark, large type, readable at 2 m. Same keys as dark; order-age colours below.",
        "bg":            "#000000",
        "surface":       "#12161C",
        "surfaceRaised": "#1C222B",
        "border":        "#8A93A1",
        "borderSubtle":  "#2F3743",
        "text":          "#FFFFFF",
        "textMuted":     "#C4CAD3",
        "textOnAccent":  "#000000",
        "focusRing":     "#FFFFFF",
        "danger":        "#FF8A80",
        "dangerBg":      "#3A1B19",
        "success":       "#5FD28A",
        "successBg":     "#14301F",
        "warning":       "#FFD166",
        "warningBg":     "#3A2D0E",
        "info":          "#7DB7F2",
        "infoBg":        "#14263A"
      }
    },
    "sync": {
      "_note": "Shared by every app. State is NEVER colour alone: each state has an icon and a text label. Foreground colours listed per theme; backgrounds reuse successBg / warningBg / dangerBg / surface.",
      "synced":   { "icon": "check-circle",   "labelKey": "sync.state.synced",   "fg": { "light": "#1A7A38", "dark": "#5FD28A", "highContrast": "#005A1F", "kds": "#5FD28A" }, "bg": "successBg" },
      "pending":  { "icon": "arrow-circle",   "labelKey": "sync.state.pending",  "fg": { "light": "#8A5A00", "dark": "#F2B84B", "highContrast": "#5C3B00", "kds": "#FFD166" }, "bg": "warningBg" },
      "offline":  { "icon": "cloud-off",      "labelKey": "sync.state.offline",  "fg": { "light": "#4A5260", "dark": "#A9B1BD", "highContrast": "#262626", "kds": "#C4CAD3" }, "bg": "surface" },
      "conflict": { "icon": "alert-triangle", "labelKey": "sync.state.conflict", "fg": { "light": "#B3261E", "dark": "#FF8A80", "highContrast": "#8F0000", "kds": "#FF8A80" }, "bg": "dangerBg" }
    },
    "kdsOrderAge": {
      "fresh":   { "maxMinutes": 5,  "token": "success" },
      "waiting": { "maxMinutes": 10, "token": "warning" },
      "late":    { "maxMinutes": null, "token": "danger", "note": "also show age as text and a pulse-free border; thresholds are per-outlet settings" }
    },
    "vendorAdmin": {
      "supportSessionBanner": { "bg": "warningBg", "fg": "warning", "border": "warning" }
    }
  },
  "typography": {
    "fontFamily": {
      "ui":   "'Noto Sans', 'Noto Sans Tamil', 'Noto Sans Malayalam', system-ui, 'Segoe UI', Roboto, sans-serif",
      "mono": "ui-monospace, 'Cascadia Mono', Consolas, 'Roboto Mono', monospace",
      "_note": "Noto Sans Tamil and Noto Sans Malayalam are bundled as local woff2 subsets (offline-first, no CDN). Latin first so digits and Rs sign stay consistent; the browser falls through per glyph to the script font."
    },
    "numeric": "tabular-nums",
    "scale": {
      "xs":   { "size": 12, "weight": 400, "note": "meta only, never actions" },
      "sm":   { "size": 14, "weight": 400 },
      "base": { "size": 16, "weight": 400, "note": "minimum for body and form input (also stops mobile zoom)" },
      "md":   { "size": 18, "weight": 500 },
      "lg":   { "size": 20, "weight": 600 },
      "xl":   { "size": 24, "weight": 600 },
      "2xl":  { "size": 32, "weight": 700 },
      "totalDisplay": { "size": 40, "weight": 700, "note": "bill total at counter" },
      "kdsBody":  { "size": 28, "weight": 600 },
      "kdsTitle": { "size": 40, "weight": 700 }
    },
    "lineHeight": {
      "latin": 1.4,
      "ta": 1.6,
      "ml": 1.7,
      "tight": 1.2,
      "_note": "Applied through :lang(ta) / :lang(ml) on the root; single-line controls use min-height, never fixed height, so taller script glyphs are not clipped."
    },
    "letterSpacing": { "default": 0, "_note": "Never add letter-spacing or uppercase transforms to Tamil/Malayalam text." }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "size": {
    "touchMin": 44,
    "touchComfortable": 48,
    "touchPrimaryAction": 56,
    "touchGapMin": 8,
    "kdsBump": 72,
    "inputHeightMin": 44,
    "iconSm": 16, "iconMd": 20, "iconLg": 24
  },
  "radius": { "none": 0, "sm": 4, "md": 8, "lg": 12, "pill": 999 },
  "border": { "width": 1, "widthStrong": 2, "focusRingWidth": 3, "focusRingOffset": 2 },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(15,18,23,0.12)",
    "2": "0 2px 8px rgba(15,18,23,0.16)",
    "3": "0 8px 24px rgba(15,18,23,0.24)",
    "_note": "Dark and high-contrast themes express elevation with surface step plus a 1-2 px border, not shadow. Low-end Android: no blur filters or backdrop-filter."
  },
  "motion": {
    "duration": { "instant": 0, "fast": 100, "base": 200, "slow": 300 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)" },
    "reducedMotion": "All durations become 0 and transforms are removed when prefers-reduced-motion is set or the user setting 'Reduce motion' is on. Motion never carries meaning; state changes also change text or icon.",
    "rules": ["animate only opacity and transform", "no animation on the billing screen's add-item path", "nothing loops except the sync 'pending' icon, which stops under reduced motion"]
  },
  "density": {
    "touch":   { "rowMinHeight": 56, "controlHeight": 48, "gap": 12, "use": "phones, tablets, POS, KDS" },
    "desktop": { "rowMinHeight": 40, "controlHeight": 36, "gap": 8,  "use": "vendor admin on mouse and keyboard only; never used by tenant apps; touch devices force 'touch' density", "note": "36 px controls are allowed only in desktop density with pointer: fine; a hit area of 44 px is still added with padding for coarse pointers" }
  },
  "zIndex": { "base": 0, "sticky": 10, "banner": 20, "dialog": 30, "toast": 40 },
  "breakpoints": { "phone": 0, "tablet": 600, "desktop": 960, "wide": 1280 }
}
