{
  "name": "@hostry/ui-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared SolidJS components, design tokens and i18n helpers for Hostry apps",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@solidjs/web": "2.0.3",
    "solid-js": "2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.3",
    "@types/node": "^22.20.5",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "solid-js": "2.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
